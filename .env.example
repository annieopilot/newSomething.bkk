# ==============================================================
# ENVIRONMENT VARIABLES FOR VERCEL DEPLOYMENT
# นำตัวแปรเหล่านี้ไปกรอกใน Vercel Dashboard -> Settings -> Environment Variables
# ==============================================================

# 1. Supabase Cloud Database (จำเป็นสำหรับระบบ Live DB และสต็อก)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 2. Prisma Database URL (สำหรับเครื่องมือ Local / Build Client)
DATABASE_URL="file:./dev.db"
